# Local packages a selection may name. A family here may select packages in
# locks/packages.tsv; an entry that selects none is still selectable and installs
# nothing by itself. Unknown names are refused.
mica-bluetooth
mica-busybox
mica-ca-trust
mica-mdev
mica-openrc
mica-ssh
mica-system
mica-systemd
mica-systemd-boot
mica-tzdata
mica-wifi
mica-wifi-ap
# The Debian packages of locks/upstream.pkgs, pinned for later stages and never in the
# base root: a row is tagged upstream-<root> for each root it is pinned for.
upstream-*
