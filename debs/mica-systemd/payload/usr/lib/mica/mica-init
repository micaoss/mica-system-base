#!/bin/sh
# What the lifecycle helpers ask of the init system, so that none of them names
# one: this is systemd's. A service is named without a suffix (mica-data-layout,
# micad); systemd's unit is <name>.service.
#
#   mica-init reboot | poweroff    start it and return
#   mica-init is-active <service>  exit 0 when it is active
#   mica-init installed <service>  exit 0 when this root ships it
#   mica-init state                the boot's state: initializing, starting, running,
#                                  degraded, maintenance or stopping
#   mica-init jobs                 the services the boot is still starting, one a line
#   mica-init failed               the failed units, one a line
set -eu

case "${1:-}" in
reboot | poweroff)
    exec systemctl --no-block "$1"
    ;;
is-active)
    exec systemctl is-active --quiet "${2:?service required}.service"
    ;;
installed)
    # list-unit-files can exit 0 with no output for an absent unit: test the output.
    [ -n "$(systemctl list-unit-files --no-legend "${2:?service required}.service" 2>/dev/null)" ]
    ;;
state)
    # is-system-running exits non-zero for every state but running; the word is the answer.
    systemctl is-system-running 2>/dev/null || true
    ;;
jobs)
    # Only running jobs; waiting ones are blocked on ordering.
    systemctl list-jobs --no-legend --plain 2>/dev/null |
        awk '$4 == "running" { sub(/\.service$/, "", $2); print $2 }'
    ;;
failed)
    systemctl list-units --state=failed --no-legend --plain --full 2>/dev/null | awk '{ print $1 }'
    ;;
*)
    echo "usage: mica-init reboot|poweroff|is-active <service>|installed <service>|state|jobs|failed" >&2
    exit 2
    ;;
esac
