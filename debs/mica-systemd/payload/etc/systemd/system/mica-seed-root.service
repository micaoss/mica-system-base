[Unit]
Description=Prepare the persistent root home directory on DATA
Documentation=file:/usr/lib/mica/mica-seed-root
# Creates root.mount's source before the bind; safe to run on every boot.
DefaultDependencies=no
RequiresMountsFor=/mica
After=mica.mount
Before=root.mount local-fs.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/mica/mica-seed-root

[Install]
WantedBy=local-fs.target
