[Unit]
Description=Start the services micad turned on, as saved on DATA
Documentation=file:/usr/lib/mica/mica-units
# The list is on /var/lib/mica; each start is queued, so nothing here waits on
# what it starts. The user's own units, which those services may rely on, are
# loaded first.
After=var-lib-mica.mount mica-load-extensions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/mica/mica-units

[Install]
WantedBy=multi-user.target
