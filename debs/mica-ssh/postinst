#!/bin/sh
# Refuse a root in which dropbear.service is enabled.
#
# Enablement is payload: this script links nothing and removes nothing.
# mica-sshd.service is enabled by the package's own link, and starts at boot only
# when micad's saved settings turn SSH on. dropbear.service, the name micad used
# before, stays disabled by its preset; the check below turns a link that arrived
# anyway into a failed build.
set -e

case "$1" in
configure) ;;
abort-upgrade | abort-remove | abort-deconfigure) exit 0 ;;
*) echo "error: postinst called with unknown argument '$1'" >&2; exit 1 ;;
esac

LINK=/etc/systemd/system/multi-user.target.wants/dropbear.service
[ ! -e "${LINK}" ] && [ ! -L "${LINK}" ] ||
    { echo "error: ${LINK} exists, so dropbear.service would start at boot beside mica-sshd.service; mica-ssh ships 50-mica-dropbear.preset to keep it disabled, and something enabled it anyway" >&2; exit 1; }
echo "dropbear.service left DISABLED in the image; mica-sshd.service starts at boot as micad's saved settings say"
