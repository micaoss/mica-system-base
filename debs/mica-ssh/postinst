#!/bin/sh
# Refuse a root in which mica-sshd.service or dropbear.service is enabled.
#
# Enablement is payload: this script links nothing and removes nothing. The
# presets keep the units disabled; the check below turns a link that arrived
# anyway into a failed build.
set -e

case "$1" in
configure) ;;
abort-upgrade | abort-remove | abort-deconfigure) exit 0 ;;
*) echo "error: postinst called with unknown argument '$1'" >&2; exit 1 ;;
esac

# micad enables mica-sshd.service, or dropbear.service, at runtime scope after
# writing its settings.
for unit in mica-sshd.service dropbear.service; do
    LINK="/etc/systemd/system/multi-user.target.wants/${unit}"
    [ ! -e "${LINK}" ] && [ ! -L "${LINK}" ] ||
        { echo "error: ${LINK} exists, so ${unit} would start at boot. SSH is disabled in the image and micad enables it at runtime; mica-ssh ships a preset in /usr/lib/systemd/system-preset to keep it disabled, and something enabled it anyway" >&2; exit 1; }
done
echo "mica-sshd.service and dropbear.service left DISABLED in the image (micad owns the lifecycle)"
