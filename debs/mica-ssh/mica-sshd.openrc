#!/sbin/openrc-run
# mica-sshd.service on an OpenRC root, with dropbear: the settings micad saves in
# /var/lib/mica/ssh/sshd.env on DATA, translated by mica-sshd-prestart. In no
# runlevel: mica-sshd-boot starts it at boot when those settings turn SSH on, and
# micad starts and stops it from access.ssh. The same service as mica-openssh's.

description="SSH server (dropbear)"
command=/usr/sbin/dropbear
supervisor=supervise-daemon
respawn_delay=2
error_logger="busybox logger -t mica-sshd"

depend() {
    need mica-mounts mica-shadow-reconcile
    after net
}

start_pre() {
    SSH_ENABLED=
    if [ -r /var/lib/mica/ssh/sshd.env ]; then
        set -a
        . /var/lib/mica/ssh/sshd.env
        set +a
    fi
    if [ "$SSH_ENABLED" != yes ]; then
        eerror "SSH is off: /var/lib/mica/ssh/sshd.env does not turn it on"
        return 1
    fi
    /usr/lib/mica/mica-sshd-prestart || return 1
    . /run/mica/sshd-dropbear.env
    command_args="-F -E -r /mnt/data/state/ssh/dropbear_ed25519_host_key ${DROPBEAR_ARGS}"
}
