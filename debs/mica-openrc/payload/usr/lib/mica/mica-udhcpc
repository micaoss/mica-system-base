#!/bin/sh
# udhcpc's script for mica-network: the lease's address, router and DNS on the
# interface, its servers in /run/mica/resolv.d/<interface>, and /run/mica/resolv.conf
# rebuilt (mica-resolv). udhcpc passes the event in $1 and the lease in the environment,
# with the default route's metric in IF_METRIC when micad gives one, and IF_INTERNET=0
# for an interface micad keeps off the default route; the interface's static routes come
# as IF_ROUTE_1, IF_ROUTE_2, ... (the stanza's route_<n>), each `<destination> [via
# <gateway>] [metric <m>]`. With no lease it falls back to an IPv4 link-local address:
# BusyBox zcip, which runs this script too, with MICA_ZCIP set.
set -eu
resolvers=/run/mica/resolv.d

# The floor links no applet beyond the commands it purged: ip is busybox's.
ip() { busybox ip "$@"; }

write_resolv() {
    /usr/lib/mica/mica-resolv
}

# ip -4 route <add|del> for each IF_ROUTE_<n> on the interface, in order. The value is
# split into words on purpose: micad writes only addresses, `via` and `metric`.
routes() {
    n=1
    while eval "r=\${IF_ROUTE_$n:-}"; [ -n "$r" ]; do
        case "$1" in
        add) ip -4 route replace $r dev "$interface" ||
            { busybox logger -t mica-udhcpc "route $r dev $interface failed" || :; } ;;
        del) ip -4 route del $r dev "$interface" 2>/dev/null || : ;;
        esac
        n=$((n + 1))
    done
}

# zcip's events: the 169.254.0.0/16 address it claimed, with its subnet route alone.
if [ -n "${MICA_ZCIP:-}" ]; then
    case "$1" in
    init) ip link set "$interface" up ;;
    config) ip -4 addr add "$ip/16" dev "$interface" scope link ;;
    deconfig) ip -4 addr del "$ip/16" dev "$interface" 2>/dev/null || : ;;
    esac
    exit 0
fi

# One zcip per interface, while it has no lease; udhcpc (-b) goes on asking.
zcip_pid=/run/mica-zcip.$interface.pid
zcip_start() {
    if [ -e "$zcip_pid" ] && kill -0 "$(cat "$zcip_pid")" 2>/dev/null; then
        return 0
    fi
    MICA_ZCIP=1 busybox zcip -f "$interface" /usr/lib/mica/mica-udhcpc </dev/null >/dev/null 2>&1 &
    echo $! >"$zcip_pid"
}
# The address flush that follows removes its address.
zcip_stop() {
    [ -e "$zcip_pid" ] || return 0
    kill "$(cat "$zcip_pid")" 2>/dev/null || :
    rm -f "$zcip_pid"
}

case "$1" in
deconfig)
    zcip_stop
    routes del
    ip -4 addr flush dev "$interface"
    ip link set "$interface" up
    rm -f "$resolvers/$interface"
    write_resolv
    ;;
bound | renew)
    zcip_stop
    ip -4 addr flush dev "$interface"
    ip -4 addr add "$ip/${mask:-24}" ${broadcast:+broadcast "$broadcast"} dev "$interface"
    # micad's metric for the interface (IF_METRIC: the stanza's `metric`, or
    # mica-wifi-client's), so two uplinks keep a default route each. An interface kept
    # off the internet (IF_INTERNET=0, the stanza's `internet 0`) takes no default route.
    [ "${IF_INTERNET:-}" = 0 ] || for gateway in ${router:-}; do
        ip -4 route replace default via "$gateway" dev "$interface" ${IF_METRIC:+metric "$IF_METRIC"}
        break
    done
    # After the address and the default route, so a route via a gateway in the lease's
    # subnet finds it; IF_INTERNET does not touch these.
    routes add
    mkdir -p "$resolvers"
    {
        [ -z "${domain:-}" ] || echo "search $domain"
        for server in ${dns:-}; do
            echo "nameserver $server"
        done
    } >"$resolvers/$interface"
    write_resolv
    ;;
leasefail)
    zcip_start
    ;;
nak)
    ;;
esac
exit 0
