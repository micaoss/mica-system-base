#!/sbin/openrc-run
# The system bus, which micad answers on. Services that need it name mica-dbus:
# dbus is Debian's own script's name, which this one does not replace.

description="D-Bus system message bus"
command=/usr/bin/dbus-daemon
command_args="--system --nofork --nopidfile --nosyslog"
supervisor=supervise-daemon

depend() {
    need mica-mounts
}

start_pre() {
    checkpath -d -m 0755 -o messagebus:messagebus /run/dbus
    # The machine id dbus needs lives on DATA; the root is read-only.
    dbus-uuidgen --ensure
}
