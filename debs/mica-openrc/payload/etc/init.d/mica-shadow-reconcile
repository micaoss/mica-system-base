#!/sbin/openrc-run
# /etc/shadow built in RAM from the accounts the image ships, before anything that
# authenticates starts.

description="Build /etc/shadow in RAM from the accounts the image ships"

depend() {
    need mica-mounts
    before micad dropbear apid
}

start() {
    ebegin "Reconciling /etc/shadow"
    /usr/lib/mica/mica-shadow-reconcile
    eend $?
}
