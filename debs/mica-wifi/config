# The wpa_supplicant build configuration of mica-wifi, the whole .config: every
# option not set here is off. nl80211 is the only driver; libnl-3 and libnl-genl-3
# are the root's, and libnl-route is not used. OpenSSL is the root's libcrypto and
# gives WPA3 (SAE) beside WPA2; there is no EAP, so no TLS library is loaded.
# The control socket is what micad scans and reads status through.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_NO_CONFIG_BLOBS=y
CONFIG_AP=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_SAE=y
CONFIG_TLS=openssl
CONFIG_GETRANDOM=y
