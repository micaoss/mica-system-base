#!/sbin/openrc-run
# mica-sshd.service on an OpenRC root, with OpenSSH: the settings micad saves in
# /var/lib/mica/ssh/sshd.env on DATA, rendered by mica-sshd-prestart into
# /run/mica/sshd_config. In no runlevel: mica-sshd-boot starts it at boot when those
# settings turn SSH on, and micad starts and stops it from access.ssh. The same
# service as mica-ssh's.

description="SSH server (OpenSSH)"
command=/usr/sbin/sshd
command_args="-D -e -f /run/mica/sshd_config"
supervisor=supervise-daemon
respawn_delay=2
error_logger="busybox logger -t mica-sshd"

depend() {
    need mica-mounts mica-shadow-reconcile
    after net
}

start_pre() {
    SSH_ENABLED=
    if [ -r /var/lib/mica/ssh/sshd.env ]; then
        set -a
        . /var/lib/mica/ssh/sshd.env
        set +a
    fi
    if [ "$SSH_ENABLED" != yes ]; then
        eerror "SSH is off: /var/lib/mica/ssh/sshd.env does not turn it on"
        return 1
    fi
    # The privilege separation directory sshd requires.
    checkpath -d -m 0755 -o root:root /run/sshd
    /usr/lib/mica/mica-sshd-prestart
}
