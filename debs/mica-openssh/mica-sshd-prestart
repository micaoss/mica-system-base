#!/bin/sh
# mica-sshd.service's ExecStartPre (mica-openssh), and mica-sshd's start_pre on
# OpenRC.
#
# Reads micad's saved /var/lib/mica/ssh/sshd.env from the environment:
#   SSH_LISTEN      listeners, each <port> (every address) or <address>:<port>
#                   (an IPv6 address in brackets)
#   SSH_PASSWORD    yes|no: password logins, and yes only while a transient root
#                   password is set
#   SSH_ROOT_LOGIN  yes|no: root logins
# Refuses anything else. Makes the ed25519 and the RSA (3072 bits) host keys on
# DATA/state, each at the first start that lacks it -- written to a temporary name
# and renamed, so an interrupted start leaves no truncated key; an existing key is
# kept. ed25519 is what clients take by default; RSA (rsa-sha2-256/512, never SHA-1
# ssh-rsa) is for clients that offer nothing else, such as GCE's SSH-in-browser.
# Each key's public half sits beside it as <key>.pub, 0644, for a provisioning agent
# (mica-gce-agent) to publish without reading the private key; a key without one, as
# on a device from before, gets it back from `ssh-keygen -y`, the same way.
# Symbolic links, foreign owners, a group/world-writable directory or public key and
# group/world-readable keys are refused. Makes
# /run/mica/authorized-keys, where a provisioning agent (mica-gce-agent) puts the
# keys of a login account as <user>, root-owned 0644 or the user's own 0600; root
# and mica never take keys from there, only from their own ~/.ssh. Then renders
# /run/mica/sshd_config, which sshd -t checks before it replaces the last one.
set -eu

state=${MICA_SSH_STATE:-/mnt/data/state/ssh}
owner=${MICA_SSH_OWNER:-0}
config=${MICA_SSHD_CONFIG:-/run/mica/sshd_config}
keys=${MICA_SSH_AUTHORIZED_KEYS:-/run/mica/authorized-keys}

refuse() { echo "mica-sshd-prestart: $*" >&2; exit 1; }

[ -n "${SSH_LISTEN:-}" ] || refuse "SSH_LISTEN from /var/lib/mica/ssh/sshd.env names no listener"
listen=
for listener in $SSH_LISTEN; do
    bad="SSH_LISTEN names '$listener', neither <port> nor <address>:<port>"
    case "$listener" in
    *[!0-9a-fA-F:.[\]]*) refuse "$bad" ;;
    *[!0-9]*) ;;
    *) listen="$listen 0.0.0.0:$listener [::]:$listener"; continue ;;
    esac
    address=${listener%:*} port=${listener##*:}
    case "$port" in '' | *[!0-9]*) refuse "$bad" ;; esac
    case "$address" in
    \[*:*\]) ;;
    *[!0-9.]* | '') refuse "$bad" ;;
    esac
    listen="$listen $listener"
done
# Password logins only while the transient root password micad set is in place:
# its marker sits beside the shadow file in RAM and is gone at every boot, while
# the saved settings are not.
marker=${MICA_SSH_TRANSIENT_MARKER:-/run/mica/transient-root-password}
if [ "${SSH_PASSWORD:-}" = yes ] && [ ! -s "$marker" ]; then SSH_PASSWORD=no; fi
case "${SSH_PASSWORD:-}" in yes | no) ;; *) refuse "SSH_PASSWORD is '${SSH_PASSWORD:-}', not yes or no" ;; esac
case "${SSH_ROOT_LOGIN:-}" in yes | no) ;; *) refuse "SSH_ROOT_LOGIN is '${SSH_ROOT_LOGIN:-}', not yes or no" ;; esac

# $1: a path owned by $owner with none of the permission bits in $2 (octal).
private() {
    [ ! -L "$1" ] || refuse "$1 is a symbolic link"
    set -- "$1" "$2" "$(stat -c '%u %a' "$1")"
    [ "${3%% *}" = "$owner" ] || refuse "$1 is owned by uid ${3%% *}, not $owner"
    [ $((0${3#* } & $2)) -eq 0 ] || refuse "$1 has mode ${3#* }"
}

[ -d "$state" ] && [ ! -L "$state" ] || refuse "$state is not a directory; mica-seed-state creates it"
private "$state" 022
# $1: the key's type, $2...: ssh-keygen's options for it.
host_key() {
    key=$state/ssh_host_$1_key
    if [ -e "$key" ] || [ -L "$key" ]; then
        private "$key" 077
        [ -f "$key" ] || refuse "$key is not a regular file"
    else
        shift
        rm -f "$key.new" "$key.new.pub"
        ssh-keygen -q "$@" -N '' -C '' -f "$key.new" >/dev/null ||
            { rm -f "$key.new" "$key.new.pub"; exit 1; }
        rm -f "$key.new.pub"
        echo "mica-sshd-prestart: generated $key"
        chmod 0600 "$key.new"
        sync "$key.new"
        mv "$key.new" "$key"
        sync -f "$state"
    fi
    if [ -e "$key.pub" ] || [ -L "$key.pub" ]; then
        private "$key.pub" 022
        [ -f "$key.pub" ] || refuse "$key.pub is not a regular file"
        return 0
    fi
    rm -f "$key.pub.new"
    ssh-keygen -y -f "$key" >"$key.pub.new" || { rm -f "$key.pub.new"; exit 1; }
    chmod 0644 "$key.pub.new"
    sync "$key.pub.new"
    mv "$key.pub.new" "$key.pub"
    sync -f "$state"
}
host_key ed25519 -t ed25519
host_key rsa -t rsa -b 3072

[ ! -L "$keys" ] || refuse "$keys is a symbolic link"
mkdir -p "$keys"
chmod 0755 "$keys"

# No PAM: sshd checks a password with crypt(3) against /etc/shadow, as dropbear
# does. An account whose shadow field is `!` is locked for every login, keys
# included; `*` is one with no password.
{
    echo "# Rendered by /usr/lib/mica/mica-sshd-prestart from /var/lib/mica/ssh/sshd.env."
    for listener in $listen; do
        echo "ListenAddress $listener"
    done
    echo "HostKey $state/ssh_host_ed25519_key"
    echo "HostKey $state/ssh_host_rsa_key"
    echo "PasswordAuthentication $SSH_PASSWORD"
    echo "PermitRootLogin $SSH_ROOT_LOGIN"
    echo "KbdInteractiveAuthentication no"
    echo "PubkeyAuthentication yes"
    echo "AuthorizedKeysFile .ssh/authorized_keys $keys/%u"
    echo "StrictModes yes"
    echo "UsePAM no"
    echo "UseDNS no"
    echo "X11Forwarding no"
    echo "PrintMotd no"
    echo "PrintLastLog no"
    echo "PidFile none"
    # OpenSSH 10's sshd offers no finite-field Diffie-Hellman by default; group14-sha256,
    # a fixed group, is back for older clients. The group-exchange methods stay off: the
    # root carries no /etc/ssh/moduli.
    echo "KexAlgorithms +diffie-hellman-group14-sha256"
    echo "Subsystem sftp /usr/lib/sftp-server"
    # Last, as a Match block runs to the end of the file.
    echo "Match User root,mica"
    echo "    AuthorizedKeysFile .ssh/authorized_keys"
} >"$config.new"
sshd -t -f "$config.new" || { rm -f "$config.new"; refuse "sshd refuses the rendered $config"; }
mv "$config.new" "$config"
