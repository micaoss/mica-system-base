#!/bin/sh
# Add sshd's privilege separation account.
#
# OpenSSH runs its unauthenticated half as the account `sshd`: a fixed uid, no
# group of its own, no shell, its home the privilege separation directory. The
# account already in place is accepted on a reinstall; the name or the uid held by
# anything else is refused. mica-shadow-reconcile gives it a locked shadow entry.
set -e

case "$1" in
configure) ;;
abort-upgrade | abort-remove | abort-deconfigure) exit 0 ;;
*) echo "error: postinst called with unknown argument '$1'" >&2; exit 1 ;;
esac

NAME=sshd
ID=22
ENTRY="${NAME}:x:${ID}:65534:OpenSSH privilege separation:/run/sshd:/usr/sbin/nologin"

held="$(awk -F: -v n="${NAME}" -v u="${ID}" '$1 == n || $3 == u' /etc/passwd)"
if [ -z "${held}" ]; then
    useradd --system --uid "${ID}" --gid 65534 --no-create-home --home-dir /run/sshd \
            --shell /usr/sbin/nologin --comment "OpenSSH privilege separation" "${NAME}"
    # A fixed last-change date keeps the root independent of the build date.
    chage -d 2020-01-01 "${NAME}"
elif [ "${held}" != "${ENTRY}" ]; then
    echo "error: uid ${ID} or the name ${NAME} is held by another account: ${held}" >&2
    exit 1
fi
[ "$(awk -F: -v n="${NAME}" '$1 == n' /etc/passwd)" = "${ENTRY}" ] ||
    { echo "error: the ${NAME} passwd entry is not the pinned one" >&2; exit 1; }
echo "${NAME} account: ${ENTRY}"
