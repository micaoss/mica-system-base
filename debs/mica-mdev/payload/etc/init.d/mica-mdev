#!/sbin/openrc-run
# Device nodes without udev: populate /dev from /sys once, then follow the kernel's
# uevents with the netlink daemon, both by busybox mdev with /etc/mdev.conf.

description="Device nodes from /sys and kernel uevents, by mdev"
command=/usr/bin/busybox
command_args="mdev -d -f"
command_background=true
# -f keeps mdev in the foreground with -d semantics: it is the netlink daemon.
pidfile=/run/mica-mdev.pid

depend() {
    need mica-kernfs
    provide dev
    before *
}

start_pre() {
    # The kernel runs no hotplug helper: the daemon hears every uevent itself. A
    # kernel built without CONFIG_UEVENT_HELPER has no such file and runs none.
    [ ! -e /proc/sys/kernel/hotplug ] || echo "" >/proc/sys/kernel/hotplug
}

start_post() {
    ebegin "Populating /dev from /sys"
    /usr/bin/busybox mdev -s
    populated=$?
    eend $populated
    # mdev -s replays no uevent, so a device present at boot whose driver is a
    # module gets none from it: load the module of every device's alias once,
    # quietly and without failing the boot on an alias no module has. One alias
    # per modprobe, as mdev.conf runs it for a uevent: busybox's small modprobe
    # takes one module, kmod's as many. kmod's is on a service's PATH when a root
    # has it, busybox's applet only in a login shell's.
    ebegin "Loading the modules of the present devices"
    modprobe=$(command -v modprobe) || modprobe="/usr/bin/busybox modprobe"
    /usr/bin/busybox find /sys/devices -name modalias -type f -exec /usr/bin/busybox cat {} + 2>/dev/null \
        | /usr/bin/busybox sort -u | /usr/bin/busybox tr '\n' '\0' \
        | /usr/bin/busybox xargs -0 -r -n 1 $modprobe -q -b 2>/dev/null
    eend 0
    return $populated
}
