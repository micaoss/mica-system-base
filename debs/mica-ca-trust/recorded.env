# The trust store mica-ca-trust ships, RECORDED: the ca-certificates version that
# produced it, and a digest over the anchor set itself.
#
# The archive is pinned as input.ca-certificates in locks/upstream.lock. This
# record is the review surface of the one payload every device's TLS believes: the packer refuses an anchor set that
# differs from it, so a pin bump that changes the certificate authorities fails
# by name until both values below are re-recorded.
#
# THE REFRESH PROCEDURE is deliberately manual. Bump input.ca-certificates
# (bun src/container.ts pin-inputs), run the packer, and re-record BOTH values it
# prints in ONE commit that changes nothing else. The diff is the review.
#
# Plain `KEY=value` lines only; the Dockerfile beside this file sources them.

# The Version field of the pinned ca-certificates archive.
CA_CERTIFICATES_VERSION=20250419

# sha256 over the `sha256sum` output of every regular file under
# /usr/share/ca-certificates, NUL-sorted by path and hashed as one stream. It
# covers the anchors' contents and names, so one anchor added, removed, renamed
# or edited moves it.
CA_CERTIFICATES_ANCHORS_SHA256=f98a1cbca4003c3b4d97248c94a8a217f6e4c3d9f86397bd7725e61c1ec67bd6
