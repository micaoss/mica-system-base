#!/bin/sh
# Shared DATA failure needs recovery; changing root deployments cannot repair it.
set -eu
INIT=${MICA_INIT:-/usr/lib/mica/mica-init}
CONSOLE=${MICA_CONSOLE:-/dev/console}
# The verdict, and on the console too unless this run's output is there already:
# best effort and bounded, so a console that does not take it never holds the
# rollback.
say() {
    echo "mica-boot-failure: $1" >&2
    [ -t 2 ] && return 0
    [ -w "$CONSOLE" ] && command -v timeout >/dev/null 2>&1 || return 0
    timeout 2 sh -c 'printf "%s\n" "$2" >"$1"' sh "$CONSOLE" "mica-boot-failure: $1" 2>/dev/null || :
}
if ! "$INIT" is-active mica-data-layout || [ -e /run/mica/shared-data-failure ]; then
    say 'shared DATA unavailable; recovery required'
    "$INIT" poweroff
    exit 0
fi
if ! timeout 30 mica-deploy fail-boot; then
    say 'cannot persist fallback selection; recovery required'
    "$INIT" poweroff
    exit 0
fi
say 'health gate failed; rebooting for bounded fallback'
"$INIT" reboot
